# Server
APP_HOST=0.0.0.0
APP_PORT=8080
BASE_URL=https://example.com
APP_DATA_DIR=./data
KIRARI_ACCESS_KEY=
APP_TIMEZONE=Asia/Shanghai

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# polling runs entirely on this machine; use webhook only behind a public HTTPS URL.
TELEGRAM_MODE=polling
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=604800

# Codex subscription runtime (no API key)
# Run `codex login` once and choose ChatGPT account login.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=240
CODEX_DRY_RUN=false
# Optional: only if your saved Codex login lives outside the default ~/.codex.
KIRARI_CODEX_HOME=
# Optional: defaults to APP_DATA_DIR/memory.
KIRARI_MEMORY_DIR=

# Semantic memory: Codex still handles conversation; Gemini is embeddings only.
# Create a free-tier key in Google AI Studio. Never commit the real value.
GEMINI_EMBEDDING_ENABLED=true
GEMINI_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_RETRY_BASE_SECONDS=5
GEMINI_EMBEDDING_RETRY_MAX_SECONDS=300
GEMINI_EMBEDDING_POLL_SECONDS=3
MEMORY_VECTOR_THRESHOLD=0.55
MEMORY_MERGE_THRESHOLD=0.82
MEMORY_SURFACE_IDLE_HOURS=6
MEMORY_SURFACE_LIMIT=3
# Used only if Gemini is absent or temporarily unavailable.
CODEX_MEMORY_RERANK=true
MEMORY_CATALOG_LIMIT=240
MEMORY_DECAY_LAMBDA=0.05
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_THRESHOLD=0.03
MEMORY_DECAY_INTERVAL_HOURS=24

# Companion behavior
DREAM_HOUR=4
DREAM_SCHEDULE_ENABLED=false
RECENT_MESSAGE_LIMIT=24

# Optional proactive Telegram check-ins. Off until explicitly enabled.
PROACTIVE_ENABLED=false
PROACTIVE_IDLE_HOURS=18
PROACTIVE_COOLDOWN_HOURS=24
PROACTIVE_QUIET_START=23
PROACTIVE_QUIET_END=8
